# Copy to `.env` and adjust for your machine.
# Pooled connection used by the running server (server/utils/prisma.ts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Direct, non-pooled connection used by the Prisma CLI (migrate, seed, studio).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
MEDIA_DIR="server/storage/media"
SESSION_TTL_DAYS="30"
# Hashes the viewer fingerprint behind the duplicate-view guard. The built-in
# fallback is for local development only — set a strong random value anywhere
# the app is deployed.
VIEWER_SECRET="change-me"

