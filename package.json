{
  "name": "learnstream",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"nitro dev --port 3001\"",
    "dev:web": "vite",
    "dev:api": "nitro dev --port 3001",
    "build": "vite build && nitro build",
    "build:web": "vite build",
    "build:api": "nitro build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "type-check": "nitro prepare && vue-tsc -b --noEmit && tsc --noEmit -p tsconfig.server.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "prepare": "prisma generate && nitro prepare"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@prisma/client": "^6.19.3",
    "h3": "1.15.11",
    "nitropack": "^2.13.6",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "prisma": "6.19.3",
    "sass": "^1.108.2",
    "typescript": "~5.6.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
